{
  "name": "lab3-server",
  "version": "1.0.0",
  "description": "Node.js server - Lab 3, Variant 4",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "predev": "npm run check",
    "dev": "node --watch --env-file=.env server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check"
  },
  "imports": {
    "#config/*": "./config/*.js",
    "#constants/*": "./constants/*.js",
    "#utils/*": "./utils/*.js",
    "#validators/*": "./validators/*.js",
    "#routes/*": "./routes/*.js",
    "#controllers/*": "./controllers/*.js"
  },
  "dependencies": {
    "ajv": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1"
  }
}
