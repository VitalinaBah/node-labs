{
  "name": "lab3-server",
  "version": "1.0.0",
  "description": "Node.js server - Lab 3, Variant 4",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "predev": "npm run check",
    "dev": "node --watch --env-file=.env server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check"
  },
  "imports": {
  "#config/*": "./config/*",
  "#constants/*": "./constants/*",
  "#utils/*": "./utils/*",
  "#validators/*": "./validators/*",
  "#routes/*": "./routes/*",
  "#controllers/*": "./controllers/*"
}
}