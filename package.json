{
  "name": "lab8-mysql-server",
  "version": "1.0.0",
  "description": "Лабораторна 8 — MySQL / mysql2 (Variant 4: Students)",
  "type": "module",
  "main": "server.js",
  "engines": { "node": ">=20.0.0", "npm": ">=10.0.0" },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "predev": "npm run check",
    "dev": "node --watch --env-file=.env server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "db:init": "node --env-file=.env db/init.js",
    "seed": "node --env-file=.env src/scripts/seed.js",
    "seed:force": "node --env-file=.env src/scripts/seed.js --force",
    "external": "json-server db.json --port 3001"
  },
  "imports": {
    "#constants/*": "./constants/*",
    "#utils/*": "./utils/*",
    "#routes/*": "./routes/*",
    "#controllers/*": "./controllers/*",
    "#schemas/*": "./schemas/*",
    "#repositories/*": "./repositories/*",
    "#services/*": "./services/*",
    "#plugins/*": "./plugins/*",
    "#transforms/*": "./src/transforms/*"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^5.0.3",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/websocket": "^11.2.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.0.1",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "json-server": "^0.17.4",
    "pino-pretty": "^13.1.3"
  }
}
